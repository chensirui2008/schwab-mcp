{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "schwab-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./public",
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "workers_dev": true,
  "vars": {
    "GITHUB_CLIENT_ID": "replace-with-your-github-client-id",
    "ALLOWED_GITHUB_USER_ID": "replace-with-your-numeric-github-user-id",
    "SCHWAB_REDIRECT_URI": "https://<your-worker-name>.<your-subdomain>.workers.dev/auth/schwab/callback",
    "MARKET_DATA_BASE_URL": "https://api.schwabapi.com/marketdata/v1",
    "TRADER_BASE_URL": "https://api.schwabapi.com/trader/v1",
    "ENABLE_TRADING": "false",
    "APP_VERSION": "0.2.0"
  },
  "secrets": {
    "required": [
      "GITHUB_CLIENT_SECRET",
      "SCHWAB_CLIENT_ID",
      "SCHWAB_CLIENT_SECRET"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "replace-with-your-kv-namespace-id"
    },
    {
      "binding": "ACCEPTANCE_KV",
      "id": "7b1dc31e3d28468e86256de817ec6bee"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SCHWAB_VAULT",
        "class_name": "SchwabVault"
      },
      {
        "name": "ACCEPTANCE_VAULT",
        "class_name": "AcceptanceVault"
      }
    ]
  },
  "ratelimits": [
    {
      "name": "BROWSER_AUTH_RATE_LIMITER",
      "namespace_id": "2026101901",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "ACCEPTANCE_BROWSER_AUTH_RATE_LIMITER",
      "namespace_id": "2026101902",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "SchwabVault"
      ]
    },
    {
      "tag": "v2-acceptance",
      "new_sqlite_classes": [
        "AcceptanceVault"
      ]
    }
  ],
  "upload_source_maps": true,
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": false,
      "persist": true
    },
    "traces": {
      "enabled": false
    }
  },
  "build": {
    "command": "node scripts/build-oauth-test-worker.mjs"
  }
}
