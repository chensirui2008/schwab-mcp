{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "schwab-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "GITHUB_CLIENT_ID": "Ov23liW2n6FLZm3U4FPE",
    "ALLOWED_GITHUB_USER_ID": "91513186",
    "SCHWAB_REDIRECT_URI": "https://schwab-mcp.siruichen461.workers.dev/auth/schwab/callback",
    "MARKET_DATA_BASE_URL": "https://api.schwabapi.com/marketdata/v1",
    "TRADER_BASE_URL": "https://api.schwabapi.com/trader/v1",
    "ENABLE_TRADING": "false",
    "APP_VERSION": "0.1.0"
  },
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "b849f6be217b4f6bac9fcb7cb8545859"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SCHWAB_VAULT",
        "class_name": "SchwabVault"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SchwabVault"]
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
