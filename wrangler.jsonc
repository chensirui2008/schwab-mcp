{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "schwab-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "GITHUB_CLIENT_ID": "replace-with-your-github-client-id",
    "ALLOWED_GITHUB_USER_ID": "replace-with-your-numeric-github-user-id",
    "SCHWAB_REDIRECT_URI": "https://<your-worker-name>.<your-subdomain>.workers.dev/auth/schwab/callback",
    "MARKET_DATA_BASE_URL": "https://api.schwabapi.com/marketdata/v1",
    "TRADER_BASE_URL": "https://api.schwabapi.com/trader/v1",
    "ENABLE_TRADING": "false",
    "APP_VERSION": "0.2.0"
  },
  "secrets": {
    "required": [
      "GITHUB_CLIENT_SECRET",
      "SCHWAB_CLIENT_ID",
      "SCHWAB_CLIENT_SECRET"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "replace-with-your-kv-namespace-id"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SCHWAB_VAULT",
        "class_name": "SchwabVault"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SchwabVault"]
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
