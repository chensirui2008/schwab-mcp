{
  "name": "schwab-mcp",
  "version": "0.2.0",
  "description": "Secure Charles Schwab Model Context Protocol (MCP) server on Cloudflare Workers with zero-trust OAuth 2.1 and safety-guarded trading workflows.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "schwab",
    "charles-schwab",
    "cloudflare-workers",
    "durable-objects",
    "trading",
    "finance",
    "ai-agents"
  ],
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types env.d.ts --include-runtime false",
    "configure:deploy": "node scripts/configure-deploy.mjs",
    "test:deploy-config": "node --test scripts/configure-deploy.test.mjs",
    "introspect": "node scripts/mcp-introspect.mjs",
    "test:introspect": "node scripts/mcp-introspect.mjs --test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "validate": "npm run types && npm run typecheck && npm run lint && npm test && npm run test:deploy-config && npm run test:introspect"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^0.8.3",
    "@modelcontextprotocol/server": "^2.0.0",
    "hono": "^4.12.27",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.19.1",
    "@cloudflare/workers-types": "^5.20260729.1",
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.46.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.115.0"
  }
}
